# Copie para .env (ou exporte no shell) e ajuste conforme o ambiente.
# credenciais NÃO ficam aqui em produção: use IAM Role / IRSA / variáveis do provedor.

SERVER_PORT=8080

# storage
S3_BUCKET=videos
AWS_REGION=us-east-1
S3_KEY_PREFIX=videos/
S3_ENDPOINT=
S3_PATH_STYLE=false
S3_CHUNKED_ENCODING=true

# streaming (aceita sufixos do Spring: 512KB, 1MB, 2MB)
STREAM_CHUNK_SIZE=1MB
STREAM_MAX_RANGE_SIZE=1MB

# CORS (lista separada por vírgula)
CORS_ALLOWED_ORIGINS=*

LOG_LEVEL=INFO
